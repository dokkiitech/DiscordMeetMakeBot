# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional: register slash commands to a single guild for instant updates.
# Leave empty to register globally (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# Google OAuth2 (Desktop App credentials work)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
# Optional. Defaults to "primary".
GOOGLE_CALENDAR_ID=primary
